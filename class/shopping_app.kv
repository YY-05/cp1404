# shopping_app.kv

BoxLayout:
    orientation: 'vertical'

    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: '50dp'

        Label:
            id: total_label
            text: "Total: $0.00"
            font_size: '24sp'

        Button:
            text: "Clear"
            on_press: app.clear_total()

    # Buttons for each product will be added dynamically from Python code
